<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ZZZae</AssemblyName>
    <RootNamespace>ZZZae.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZZZae.Core\ZZZae.Core.csproj" />
    <ProjectReference Include="..\ZZZae.Formats\ZZZae.Formats.csproj" />
    <ProjectReference Include="..\ZZZae.Protocol\ZZZae.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(HookBinaryPath)' != '' and Exists('$(HookBinaryPath)')">
    <EmbeddedResource Include="$(HookBinaryPath)" LogicalName="ZZZae.Hook.dll" />
  </ItemGroup>

  <Target
    Name="ValidateEmbeddedHook"
    BeforeTargets="PrepareForPublish"
    Condition="'$(RequireEmbeddedHook)' == 'true'"
  >
    <Error
      Condition="'$(HookBinaryPath)' == ''"
      Text="HookBinaryPath must point to the published NativeAOT hook library."
    />
    <Error
      Condition="!Exists('$(HookBinaryPath)')"
      Text="The hook library was not found at '$(HookBinaryPath)'."
    />
  </Target>
</Project>
